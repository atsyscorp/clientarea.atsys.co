# Plantilla de variables de entorno.
# Copia este archivo como .env y rellena los valores reales.
# El archivo .env NO se versiona (ver .gitignore).

# --- Base de datos ---
DB_DSN=mysql:host=localhost;dbname=atclient_app
DB_USERNAME=atclient_app
DB_PASSWORD=

# --- Aplicacion ---
# Clave de validacion de cookies. Generar una nueva por entorno, 32+ caracteres:
#   php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
COOKIE_VALIDATION_KEY=

# --- Correo saliente (SMTP) ---
MAIL_SCHEME=smtps
MAIL_HOST=nexus01.atsys.co
MAIL_PORT=465
MAIL_USERNAME=noreply@atsys.co
# La consola (cron, workers) envía con otra cuenta
MAIL_CONSOLE_USERNAME=soporte@atsys.co
MAIL_PASSWORD=
# --- Administración y Notificaciones ---
ADMIN_EMAIL=gerencia@atsys.co
RENEWAL_ALERTS_BCC_EMAIL=gerencia@atsys.co

# --- Cloudflare Turnstile ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- n8n (webhooks de automatizacion) ---
N8N_BASE_URL=https://n8n.atsys.co
N8N_WEBHOOK_URL=https://n8n-new.atsys.co/webhook/atsys-clientarea-alert

# --- Webhook entrante (cabecera X-API-KEY) ---
WEBHOOK_SECRET_KEY=

# --- Namecheap API ---
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_SANDBOX=false

# --- Virtualmin API (DNS Management) ---
VIRTUALMIN_URL=https://127.0.0.1:10000/virtual-server/remote.cgi
VIRTUALMIN_USER=atsys
VIRTUALMIN_PASSWORD=
VIRTUALMIN_PARKED_PARENT=midominiomaestro.com
